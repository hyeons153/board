# Neon project board2, used only for the Hall of Fame.
HALL_DATABASE_URL=
# Direct board2 connection for migrations and one-off Hall maintenance.
HALL_DATABASE_DIRECT_URL=
# Deployment-only random key, at least 32 characters. Keep it stable across deployments.
GAME_SAVE_SECRET=
# Authentication rate-limit secret. Existing deployments also use it as a save-key fallback.
AUTH_RATE_SECRET=
# Optional read-only source for a player-requested migration from an older deployment.
LEGACY_SAVE_DATABASE_URL=
# Optional local pacing override. The production default is 2000 ms.
WEEK_MS=2000
