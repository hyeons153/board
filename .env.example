# Neon PostgreSQL connection URL, used only on the server.
DATABASE_URL=
# Optional direct Neon URL for migrations (otherwise DATABASE_URL is used).
DATABASE_DIRECT_URL=
# Neon CLI writes DATABASE_URL_UNPOOLED as the direct migration URL.
DATABASE_URL_UNPOOLED=
# 32+ characters of server-only random data for authentication rate limiting on Vercel.
AUTH_RATE_SECRET=
# Optional local pacing override. The default on every deployment is 2000 (2 seconds).
WEEK_MS=2000
